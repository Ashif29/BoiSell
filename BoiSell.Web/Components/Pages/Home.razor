@page "/"
@using BoiSell.Core.Models
@using BoiSell.Service.Extentions
@using BoiSell.Service.Services.Contracts

@inject IBookService _bookService
@inject IJSRuntime _JS

<_BsModal OnModalConfirmation="ConfirmBuyClick"
          Title="Are you sure to buy this Book?"
          ButtonBootstrapStyle="btn-success"
          ButtonText="Shop Now">
</_BsModal>

<div class="jumbotron text-center">
    <h1>Welcome to BoiSell</h1>
    <p>Discover the best books at lowest prices</p>
    <a href="#" class="btn btn-primary">Shop Now</a>
</div>

@if (IsProcessing)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
        <p>Loading...</p>
    </div>
}
else
{
    <div class="container my-4">
        <h2 class="text-center">Our Books</h2>
        <hr />
        <div class="row">
            @if (Books.Any())
            {
                @foreach (var book in Books)
                {
                    <div class="col-lg-2 col-md-4 col-sm-6 mb-4">
                        <div class="card">
                            <img class="card-img-top" src="@book.ImageUrl" alt="Book Image" style="width: 137px; height: 220px; object-fit: cover; margin: 0 auto;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <p class="card-title text-success" style="font-size: 12px;">@book.Title</p>
                                    <p class="card-title" style="font-size: 12px;"> By: @book.Author</p>
                                    <p class="card-title" style="font-size: 12px;"> Category: @book.Category.Name</p>
                                    
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <p class="card-title" style="font-size: 10px;"> BDT: @book.Price</p>
                                    <button class="btn btn-primary" @onclick="() => HandleAddToCart(book.Id)">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    public bool IsProcessing { get; set; } = true;

    private IEnumerable<Book> Books { get; set; } = new List<Book>();

    private int BuyBookId { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBooks();
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadBooks()
    {
        Books = await _bookService.GetAllAsync(includeProperties: "Category");
    }

    private void HandleAddToCart(int id)
    {
        BuyBookId = id;
        _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ConfirmBuyClick(bool IsConfirmed)
    {
        IsProcessing = true;
        await _JS.InvokeVoidAsync("HideConfirmationModal");
        if (IsConfirmed == true && BuyBookId > 0)
        {
            await _JS.ToastrSuccess("Book Add To Cart Successfully.");
        }
        else
        {
            await _JS.ToastrError("Error Encountered While Buying.");
        }
        await LoadBooks();
        BuyBookId = 0;
        IsProcessing = false;
    }
}
